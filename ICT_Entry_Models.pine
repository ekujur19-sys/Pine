//@version=6
// ICT Entry Models — 2022 Model & Unicorn Setup
// Educational implementation of common retail-ICT concepts: liquidity sweeps,
// market structure shifts (MSS/CHoCH), fair value gaps (FVG), order blocks
// and breaker-block/FVG overlap ("Unicorn"). Not official ICT material —
// definitions below are simplified approximations for automation purposes.
strategy("ICT Entry Models — 2022 Model & Unicorn Setup", shorttitle = "ICT 2022/Unicorn",
     overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 10000, currency = currency.USD,
     commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = 1)

// ───────────────────────────── Inputs ─────────────────────────────
grpModel = "Model Selection"
tradeModel     = input.string("Both", "ICT Entry Model", options = ["2022 Model", "Unicorn Model", "Both"], group = grpModel)
tradeDirection = input.string("Both", "Trade Direction", options = ["Both", "Long Only", "Short Only"], group = grpModel)

grpStruct = "Market Structure"
swingLen   = input.int(5, "Swing Length (pivot bars each side)", minval = 1, group = grpStruct)
maxWaitBars = input.int(60, "Max Bars to Wait for MSS after Sweep", minval = 5, group = grpStruct)

grpFVG = "Fair Value Gap"
fvgMinSizeATRmult = input.float(0.0, "Min FVG Size (x ATR)", minval = 0.0, step = 0.1, group = grpFVG)
fvgMaxAgeBars      = input.int(50, "Max Zone Age (bars)", minval = 5, group = grpFVG)

grpOB = "Order Block / Breaker (Unicorn)"
obLookback = input.int(6, "OB Search Lookback (bars)", minval = 1, maxval = 20, group = grpOB)

grpSess = "Session / Killzones"
useKillzones  = input.bool(true, "Only Arm Setups During Killzones", group = grpSess)
londonKZ      = input.session("0200-0500", "London Killzone", group = grpSess)
nyamKZ        = input.session("0830-1100", "NY AM Killzone", group = grpSess)
nypmKZ        = input.session("1330-1600", "NY PM Killzone", group = grpSess)
sessTimezone  = input.string("America/New_York", "Session Timezone", group = grpSess)

grpRisk = "Risk Management"
slBufferATRmult = input.float(0.1, "SL Buffer (x ATR)", minval = 0.0, step = 0.05, group = grpRisk)
rrRatio         = input.float(2.0, "Risk : Reward Ratio", minval = 0.1, step = 0.1, group = grpRisk)
useEquityRisk   = input.bool(true, "Size by % Risk per Trade", group = grpRisk)
riskPercent     = input.float(1.0, "Risk % per Trade", minval = 0.1, step = 0.1, group = grpRisk)

grpDisp = "Display"
showFVG     = input.bool(true, "Show FVG Zones", group = grpDisp)
showOB      = input.bool(true, "Show Order Blocks / Unicorn Zones", group = grpDisp)
showSweeps  = input.bool(true, "Show Liquidity Sweeps", group = grpDisp)
showMSS     = input.bool(true, "Show Market Structure Shifts", group = grpDisp)
colBull     = input.color(color.new(color.teal, 75), "Bullish Zone Color", group = grpDisp)
colBear     = input.color(color.new(color.maroon, 75), "Bearish Zone Color", group = grpDisp)
colUnicorn  = input.color(color.new(color.purple, 55), "Unicorn Zone Color", group = grpDisp)

// ───────────────────────────── Types ─────────────────────────────
type Zone
    float top
    float bottom
    bool  isBull
    int   startBar
    string kind      // "FVG", "OB", "Unicorn"
    box   b

var array<Zone> zones = array.new<Zone>()

// ───────────────────────────── Helpers ─────────────────────────────
atr = ta.atr(14)

inKillzone = not na(time(timeframe.period, londonKZ, sessTimezone)) or
             not na(time(timeframe.period, nyamKZ, sessTimezone)) or
             not na(time(timeframe.period, nypmKZ, sessTimezone))

f_findOB(wantBearish, fromOffset, maxLookback) =>
    int foundOffset = na
    for i = fromOffset to fromOffset + maxLookback
        bool isBearish = close[i] < open[i]
        bool isBullish = close[i] > open[i]
        bool match = wantBearish ? isBearish : isBullish
        if match and na(foundOffset)
            foundOffset := i
    float obTop = na(foundOffset) ? na : high[foundOffset]
    float obBot = na(foundOffset) ? na : low[foundOffset]
    [obTop, obBot, foundOffset]

f_pruneZones(maxAge) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            z = array.get(zones, i)
            box.set_right(z.b, bar_index)
            bool expired   = (bar_index - z.startBar) > maxAge
            bool mitigated = z.isBull ? close < z.bottom : close > z.top
            if expired or mitigated
                box.delete(z.b)
                array.remove(zones, i)

f_scanZone(kindWanted, isBullWanted, fromBar, toBar) =>
    float rTop = na
    float rBot = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            z = array.get(zones, i)
            if na(rTop) and z.kind == kindWanted and z.isBull == isBullWanted and z.startBar >= fromBar and z.startBar <= toBar
                rTop := z.top
                rBot := z.bottom
    [rTop, rBot]

// ───────────────────────────── FVG / OB / Unicorn detection ─────────────────────────────
bool bullGap = low > high[2]
bool bearGap = high < low[2]

if bullGap and (low - high[2]) >= fvgMinSizeATRmult * atr
    float top = low
    float bot = high[2]
    if showFVG
        bx = box.new(bar_index - 2, top, bar_index, bot, border_color = na, bgcolor = colBull)
        array.push(zones, Zone.new(top, bot, true, bar_index - 1, "FVG", bx))
    else
        array.push(zones, Zone.new(top, bot, true, bar_index - 1, "FVG", box.new(bar_index - 2, top, bar_index, bot, border_color = na, bgcolor = color.new(color.white, 100))))
    [obTop, obBot, obOff] = f_findOB(true, 2, obLookback)
    if not na(obOff)
        float ovTop = math.min(top, obTop)
        float ovBot = math.max(bot, obBot)
        if ovTop > ovBot
            if showOB
                ubx = box.new(bar_index - obOff, ovTop, bar_index, ovBot, border_color = color.purple, bgcolor = colUnicorn)
                array.push(zones, Zone.new(ovTop, ovBot, true, bar_index - 1, "Unicorn", ubx))
            else
                array.push(zones, Zone.new(ovTop, ovBot, true, bar_index - 1, "Unicorn", box.new(bar_index - obOff, ovTop, bar_index, ovBot, border_color = na, bgcolor = color.new(color.white, 100))))

if bearGap and (low[2] - high) >= fvgMinSizeATRmult * atr
    float top = low[2]
    float bot = high
    if showFVG
        bx = box.new(bar_index - 2, top, bar_index, bot, border_color = na, bgcolor = colBear)
        array.push(zones, Zone.new(top, bot, false, bar_index - 1, "FVG", bx))
    else
        array.push(zones, Zone.new(top, bot, false, bar_index - 1, "FVG", box.new(bar_index - 2, top, bar_index, bot, border_color = na, bgcolor = color.new(color.white, 100))))
    [obTop, obBot, obOff] = f_findOB(false, 2, obLookback)
    if not na(obOff)
        float ovTop = math.min(top, obTop)
        float ovBot = math.max(bot, obBot)
        if ovTop > ovBot
            if showOB
                ubx = box.new(bar_index - obOff, ovTop, bar_index, ovBot, border_color = color.purple, bgcolor = colUnicorn)
                array.push(zones, Zone.new(ovTop, ovBot, false, bar_index - 1, "Unicorn", ubx))
            else
                array.push(zones, Zone.new(ovTop, ovBot, false, bar_index - 1, "Unicorn", box.new(bar_index - obOff, ovTop, bar_index, ovBot, border_color = na, bgcolor = color.new(color.white, 100))))

f_pruneZones(math.max(fvgMaxAgeBars, obLookback + 10))

// ───────────────────────────── Swing structure ─────────────────────────────
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

var float swingHighVal   = na
var int   swingHighBar   = na
var bool  swingHighTaken = false
var float swingLowVal    = na
var int   swingLowBar    = na
var bool  swingLowTaken  = false

if not na(ph)
    swingHighVal   := ph
    swingHighBar   := bar_index - swingLen
    swingHighTaken := false
if not na(pl)
    swingLowVal   := pl
    swingLowBar   := bar_index - swingLen
    swingLowTaken := false

// ───────────────────────────── Liquidity sweep detection ─────────────────────────────
var bool  awaitingBullishMSS = false
var float bullishSweepLevel  = na
var int   bullishSweepBar    = na
var float bullishMSSTarget   = na

var bool  awaitingBearishMSS = false
var float bearishSweepLevel  = na
var int   bearishSweepBar    = na
var float bearishMSSTarget   = na

bool sweepLow  = not na(swingLowVal)  and not swingLowTaken  and low  < swingLowVal  and close > swingLowVal  and (not useKillzones or inKillzone)
bool sweepHigh = not na(swingHighVal) and not swingHighTaken and high > swingHighVal and close < swingHighVal and (not useKillzones or inKillzone)

if sweepLow
    swingLowTaken       := true
    awaitingBullishMSS  := true
    bullishSweepLevel   := low
    bullishSweepBar     := bar_index
    bullishMSSTarget    := swingHighVal
    if showSweeps
        label.new(bar_index, low, "SSL Sweep", style = label.style_label_up, color = color.new(color.teal, 20), textcolor = color.white, size = size.tiny)

if sweepHigh
    swingHighTaken      := true
    awaitingBearishMSS  := true
    bearishSweepLevel   := high
    bearishSweepBar     := bar_index
    bearishMSSTarget     := swingLowVal
    if showSweeps
        label.new(bar_index, high, "BSL Sweep", style = label.style_label_down, color = color.new(color.maroon, 20), textcolor = color.white, size = size.tiny)

// timeout abandonment
if awaitingBullishMSS and (bar_index - bullishSweepBar) > maxWaitBars
    awaitingBullishMSS := false
if awaitingBearishMSS and (bar_index - bearishSweepBar) > maxWaitBars
    awaitingBearishMSS := false

bool bullishMSSConfirmed = awaitingBullishMSS and not na(bullishMSSTarget) and close > bullishMSSTarget
bool bearishMSSConfirmed = awaitingBearishMSS and not na(bearishMSSTarget) and close < bearishMSSTarget

if bullishMSSConfirmed
    awaitingBullishMSS := false
    if showMSS
        line.new(bullishSweepBar, bullishMSSTarget, bar_index, bullishMSSTarget, color = color.teal, width = 2, extend = extend.none)
        label.new(bar_index, bullishMSSTarget, "Bullish MSS", style = label.style_label_down, color = color.teal, textcolor = color.white, size = size.small)

if bearishMSSConfirmed
    awaitingBearishMSS := false
    if showMSS
        line.new(bearishSweepBar, bearishMSSTarget, bar_index, bearishMSSTarget, color = color.maroon, width = 2, extend = extend.none)
        label.new(bar_index, bearishMSSTarget, "Bearish MSS", style = label.style_label_up, color = color.maroon, textcolor = color.white, size = size.small)

// ───────────────────────────── Pending setup state ─────────────────────────────
var float p2022LongTop = na
var float p2022LongBot = na
var float p2022LongSL = na
var float p2022LongTP = na
var bool  p2022LongActive = false
var int   p2022LongBar = na

var float p2022ShortTop = na
var float p2022ShortBot = na
var float p2022ShortSL = na
var float p2022ShortTP = na
var bool  p2022ShortActive = false
var int   p2022ShortBar = na

var float pUniLongTop = na
var float pUniLongBot = na
var float pUniLongSL = na
var float pUniLongTP = na
var bool  pUniLongActive = false
var int   pUniLongBar = na

var float pUniShortTop = na
var float pUniShortBot = na
var float pUniShortSL = na
var float pUniShortTP = na
var bool  pUniShortActive = false
var int   pUniShortBar = na

bool allowLong  = tradeDirection != "Short Only"
bool allowShort = tradeDirection != "Long Only"
bool allow2022    = tradeModel != "Unicorn Model"
bool allowUnicorn = tradeModel != "2022 Model"
bool flat = strategy.position_size == 0

if bullishMSSConfirmed and flat
    [fvgTop, fvgBot] = f_scanZone("FVG", true, bullishSweepBar, bar_index)
    [uniTop, uniBot] = f_scanZone("Unicorn", true, bullishSweepBar, bar_index)
    if allow2022 and allowLong and not na(fvgTop)
        p2022LongTop := fvgTop
        p2022LongBot := fvgBot
        p2022LongSL  := bullishSweepLevel - atr * slBufferATRmult
        float entryP = (fvgTop + fvgBot) / 2
        p2022LongTP  := entryP + (entryP - p2022LongSL) * rrRatio
        p2022LongActive := true
        p2022LongBar := bar_index
    if allowUnicorn and allowLong and not na(uniTop)
        pUniLongTop := uniTop
        pUniLongBot := uniBot
        pUniLongSL  := bullishSweepLevel - atr * slBufferATRmult
        float entryP = (uniTop + uniBot) / 2
        pUniLongTP  := entryP + (entryP - pUniLongSL) * rrRatio
        pUniLongActive := true
        pUniLongBar := bar_index

if bearishMSSConfirmed and flat
    [fvgTop, fvgBot] = f_scanZone("FVG", false, bearishSweepBar, bar_index)
    [uniTop, uniBot] = f_scanZone("Unicorn", false, bearishSweepBar, bar_index)
    if allow2022 and allowShort and not na(fvgTop)
        p2022ShortTop := fvgTop
        p2022ShortBot := fvgBot
        p2022ShortSL  := bearishSweepLevel + atr * slBufferATRmult
        float entryP = (fvgTop + fvgBot) / 2
        p2022ShortTP  := entryP - (p2022ShortSL - entryP) * rrRatio
        p2022ShortActive := true
        p2022ShortBar := bar_index
    if allowUnicorn and allowShort and not na(uniTop)
        pUniShortTop := uniTop
        pUniShortBot := uniBot
        pUniShortSL  := bearishSweepLevel + atr * slBufferATRmult
        float entryP = (uniTop + uniBot) / 2
        pUniShortTP  := entryP - (pUniShortSL - entryP) * rrRatio
        pUniShortActive := true
        pUniShortBar := bar_index

// ───────────────────────────── Order management ─────────────────────────────
f_qty(entryP, slP) =>
    float dist = math.abs(entryP - slP)
    float q = na
    if useEquityRisk and dist > 0
        q := (strategy.equity * riskPercent / 100) / dist
    q

// cancel / expire helpers
if p2022LongActive and (close < p2022LongSL or (bar_index - p2022LongBar) > fvgMaxAgeBars or strategy.position_size != 0)
    strategy.cancel("2022 Long")
    p2022LongActive := false
if p2022ShortActive and (close > p2022ShortSL or (bar_index - p2022ShortBar) > fvgMaxAgeBars or strategy.position_size != 0)
    strategy.cancel("2022 Short")
    p2022ShortActive := false
if pUniLongActive and (close < pUniLongSL or (bar_index - pUniLongBar) > fvgMaxAgeBars or strategy.position_size != 0)
    strategy.cancel("Unicorn Long")
    pUniLongActive := false
if pUniShortActive and (close > pUniShortSL or (bar_index - pUniShortBar) > fvgMaxAgeBars or strategy.position_size != 0)
    strategy.cancel("Unicorn Short")
    pUniShortActive := false

if p2022LongActive and flat
    float entryP = (p2022LongTop + p2022LongBot) / 2
    float q = f_qty(entryP, p2022LongSL)
    if useEquityRisk and not na(q)
        strategy.entry("2022 Long", strategy.long, qty = q, limit = entryP)
    else
        strategy.entry("2022 Long", strategy.long, limit = entryP)
    strategy.exit("2022 Long Exit", "2022 Long", stop = p2022LongSL, limit = p2022LongTP)

if p2022ShortActive and flat
    float entryP = (p2022ShortTop + p2022ShortBot) / 2
    float q = f_qty(entryP, p2022ShortSL)
    if useEquityRisk and not na(q)
        strategy.entry("2022 Short", strategy.short, qty = q, limit = entryP)
    else
        strategy.entry("2022 Short", strategy.short, limit = entryP)
    strategy.exit("2022 Short Exit", "2022 Short", stop = p2022ShortSL, limit = p2022ShortTP)

if pUniLongActive and flat
    float entryP = (pUniLongTop + pUniLongBot) / 2
    float q = f_qty(entryP, pUniLongSL)
    if useEquityRisk and not na(q)
        strategy.entry("Unicorn Long", strategy.long, qty = q, limit = entryP)
    else
        strategy.entry("Unicorn Long", strategy.long, limit = entryP)
    strategy.exit("Unicorn Long Exit", "Unicorn Long", stop = pUniLongSL, limit = pUniLongTP)

if pUniShortActive and flat
    float entryP = (pUniShortTop + pUniShortBot) / 2
    float q = f_qty(entryP, pUniShortSL)
    if useEquityRisk and not na(q)
        strategy.entry("Unicorn Short", strategy.short, qty = q, limit = entryP)
    else
        strategy.entry("Unicorn Short", strategy.short, limit = entryP)
    strategy.exit("Unicorn Short Exit", "Unicorn Short", stop = pUniShortSL, limit = pUniShortTP)

// once a position opens, stop offering the other pending setups of the same bias/model
if strategy.position_size > 0
    p2022ShortActive := false
    pUniShortActive := false
if strategy.position_size < 0
    p2022LongActive := false
    pUniLongActive := false

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(sweepLow,  title = "Sell-Side Liquidity Sweep", message = "Sell-side liquidity swept — bullish setup armed")
alertcondition(sweepHigh, title = "Buy-Side Liquidity Sweep",  message = "Buy-side liquidity swept — bearish setup armed")
alertcondition(bullishMSSConfirmed, title = "Bullish MSS", message = "Bullish Market Structure Shift confirmed")
alertcondition(bearishMSSConfirmed, title = "Bearish MSS", message = "Bearish Market Structure Shift confirmed")

// ───────────────────────────── Plots ─────────────────────────────
plotshape(showMSS and bullishMSSConfirmed, title = "Bullish MSS Marker", style = shape.triangleup, location = location.belowbar, color = color.teal, size = size.tiny)
plotshape(showMSS and bearishMSSConfirmed, title = "Bearish MSS Marker", style = shape.triangledown, location = location.abovebar, color = color.maroon, size = size.tiny)
