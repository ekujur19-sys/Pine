//@version=6
// ICT Entry Models - 2022 Model & Unicorn Setup
//
// Educational implementation of commonly-taught retail-ICT concepts:
// liquidity sweeps, market structure shifts (MSS / CHoCH), fair value gaps,
// order blocks, and order-block/FVG overlap ("Unicorn"). These are simplified
// approximations suitable for automation, not official ICT material.
//
// Logic outline:
//   1. Track swing highs/lows (pivots).
//   2. Detect a liquidity sweep: wick through a swing point, close back inside.
//   3. Confirm MSS: a close back through the opposite swing point.
//   4. Entry zone = FVG (2022 Model) or OB/FVG overlap (Unicorn) formed during
//      the displacement leg between the sweep and the MSS.
//   5. Buy/sell limit at the zone midpoint (CE), stop beyond the sweep wick,
//      target at a fixed R multiple.

strategy("ICT Entry Models - 2022 Model & Unicorn Setup", shorttitle = "ICT 2022/Unicorn", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1)

// Satisfies Pine's "must contain at least one output call" requirement up
// front, so a partial paste still compiles and reveals the real problem.
plot(close, title = "Close", display = display.none)

// ---------------------------------- Inputs ----------------------------------
grpModel = "Model Selection"
tradeModel     = input.string("Both", "ICT Entry Model", options = ["2022 Model", "Unicorn Model", "Both"], group = grpModel)
tradeDirection = input.string("Both", "Trade Direction", options = ["Both", "Long Only", "Short Only"], group = grpModel)

grpStruct = "Market Structure"
swingLen    = input.int(5, "Swing Length (pivot bars each side)", minval = 1, group = grpStruct)
maxWaitBars = input.int(60, "Max Bars to Wait for MSS after Sweep", minval = 5, group = grpStruct)

grpFVG = "Fair Value Gap"
fvgMinSizeATRmult = input.float(0.0, "Min FVG Size (x ATR)", minval = 0.0, step = 0.1, group = grpFVG)
fvgMaxAgeBars     = input.int(50, "Max Zone Age (bars)", minval = 5, group = grpFVG)

grpOB = "Order Block / Breaker (Unicorn)"
obLookback = input.int(6, "OB Search Lookback (bars)", minval = 1, maxval = 20, group = grpOB)

grpSess = "Session / Killzones"
useKillzones = input.bool(true, "Only Arm Setups During Killzones", group = grpSess)
londonKZ     = input.session("0200-0500", "London Killzone", group = grpSess)
nyamKZ       = input.session("0830-1100", "NY AM Killzone", group = grpSess)
nypmKZ       = input.session("1330-1600", "NY PM Killzone", group = grpSess)
sessTimezone = input.string("America/New_York", "Session Timezone", group = grpSess)

grpRisk = "Risk Management"
slBufferATRmult = input.float(0.1, "SL Buffer (x ATR)", minval = 0.0, step = 0.05, group = grpRisk)
rrRatio         = input.float(2.0, "Risk : Reward Ratio", minval = 0.1, step = 0.1, group = grpRisk)
useEquityRisk   = input.bool(true, "Size by % Risk per Trade", group = grpRisk)
riskPercent     = input.float(1.0, "Risk % per Trade", minval = 0.1, step = 0.1, group = grpRisk)

grpDisp = "Display"
showFVG    = input.bool(true, "Show FVG Zones", group = grpDisp)
showOB     = input.bool(true, "Show Unicorn (OB + FVG) Zones", group = grpDisp)
showSweeps = input.bool(true, "Show Liquidity Sweeps", group = grpDisp)
showMSS    = input.bool(true, "Show Market Structure Shifts", group = grpDisp)
colBull    = input.color(color.new(color.teal, 80), "Bullish Zone Color", group = grpDisp)
colBear    = input.color(color.new(color.maroon, 80), "Bearish Zone Color", group = grpDisp)
colUnicorn = input.color(color.new(color.purple, 60), "Unicorn Zone Color", group = grpDisp)

// ------------------------------ Zone storage --------------------------------
// Parallel arrays instead of a user-defined type: zones are appended in
// chronological order and never removed mid-iteration, only flagged inactive.
var array<float>  zoneTop      = array.new_float()
var array<float>  zoneBot      = array.new_float()
var array<bool>   zoneIsBull   = array.new_bool()
var array<int>    zoneStartBar = array.new_int()
var array<string> zoneKind     = array.new_string()
var array<bool>   zoneActive   = array.new_bool()
var array<box>    zoneBox      = array.new_box()

atr = ta.atr(14)

inKillzone = not na(time(timeframe.period, londonKZ, sessTimezone)) or not na(time(timeframe.period, nyamKZ, sessTimezone)) or not na(time(timeframe.period, nypmKZ, sessTimezone))

// ------------------------------- Helpers ------------------------------------
// Order block search. Each returns a single value and indexes history only
// with the loop counter, which is always a valid history-reference offset.
f_obTop(wantBearish, fromOffset, maxLookback) =>
    float r = na
    for i = fromOffset to fromOffset + maxLookback
        bool hit = wantBearish ? close[i] < open[i] : close[i] > open[i]
        if na(r) and hit
            r := high[i]
    r

f_obBot(wantBearish, fromOffset, maxLookback) =>
    float r = na
    for i = fromOffset to fromOffset + maxLookback
        bool hit = wantBearish ? close[i] < open[i] : close[i] > open[i]
        if na(r) and hit
            r := low[i]
    r

f_obBar(wantBearish, fromOffset, maxLookback) =>
    int r = -1
    for i = fromOffset to fromOffset + maxLookback
        bool hit = wantBearish ? close[i] < open[i] : close[i] > open[i]
        if r == -1 and hit
            r := bar_index - i
    r

f_addZone(kind, zTop, zBot, isBull, startBar, leftBar, col) =>
    box bx = box.new(leftBar, zTop, bar_index, zBot, border_color = color.new(color.gray, 100), bgcolor = col)
    array.push(zoneTop, zTop)
    array.push(zoneBot, zBot)
    array.push(zoneIsBull, isBull)
    array.push(zoneStartBar, startBar)
    array.push(zoneKind, kind)
    array.push(zoneActive, true)
    array.push(zoneBox, bx)

// Returns the index of the oldest matching active zone, or -1 when none match.
f_findZoneIdx(kindWanted, isBullWanted, fromBar, toBar) =>
    int idx = -1
    if array.size(zoneKind) > 0
        for i = 0 to array.size(zoneKind) - 1
            if idx == -1 and array.get(zoneActive, i) and array.get(zoneKind, i) == kindWanted and array.get(zoneIsBull, i) == isBullWanted and array.get(zoneStartBar, i) >= fromBar and array.get(zoneStartBar, i) <= toBar
                idx := i
    idx

f_qty(entryP, slP) =>
    float dist = math.abs(entryP - slP)
    float q = na
    if dist > 0
        q := (strategy.equity * riskPercent / 100) / dist
    q

// --------------------- FVG / Unicorn zone detection -------------------------
bool bullGap = low > high[2]
bool bearGap = high < low[2]

if bullGap and (low - high[2]) >= fvgMinSizeATRmult * atr
    float gTop = low
    float gBot = high[2]
    f_addZone("FVG", gTop, gBot, true, bar_index - 1, bar_index - 2, showFVG ? colBull : color.new(color.gray, 100))
    // Bullish OB = last down-close candle before the displacement leg.
    float obT = f_obTop(true, 2, obLookback)
    float obB = f_obBot(true, 2, obLookback)
    int   obX = f_obBar(true, 2, obLookback)
    if obX >= 0
        float ovTop = math.min(gTop, obT)
        float ovBot = math.max(gBot, obB)
        if ovTop > ovBot
            f_addZone("Unicorn", ovTop, ovBot, true, bar_index - 1, obX, showOB ? colUnicorn : color.new(color.gray, 100))

if bearGap and (low[2] - high) >= fvgMinSizeATRmult * atr
    float gTop = low[2]
    float gBot = high
    f_addZone("FVG", gTop, gBot, false, bar_index - 1, bar_index - 2, showFVG ? colBear : color.new(color.gray, 100))
    // Bearish OB = last up-close candle before the displacement leg.
    float obT = f_obTop(false, 2, obLookback)
    float obB = f_obBot(false, 2, obLookback)
    int   obX = f_obBar(false, 2, obLookback)
    if obX >= 0
        float ovTop = math.min(gTop, obT)
        float ovBot = math.max(gBot, obB)
        if ovTop > ovBot
            f_addZone("Unicorn", ovTop, ovBot, false, bar_index - 1, obX, showOB ? colUnicorn : color.new(color.gray, 100))

// ------------------------- Zone maintenance ---------------------------------
// Forward-only pass: extend live zones, retire expired or mitigated ones.
if array.size(zoneTop) > 0
    for i = 0 to array.size(zoneTop) - 1
        if array.get(zoneActive, i)
            float zT = array.get(zoneTop, i)
            float zB = array.get(zoneBot, i)
            bool  zBull = array.get(zoneIsBull, i)
            int   zBar = array.get(zoneStartBar, i)
            box   zBx = array.get(zoneBox, i)
            bool expired = (bar_index - zBar) > fvgMaxAgeBars
            bool mitigated = zBull ? close < zB : close > zT
            if expired or mitigated
                box.delete(zBx)
                array.set(zoneActive, i, false)
            else
                box.set_right(zBx, bar_index)

// Bound memory: drop the oldest entries once the history grows large.
if array.size(zoneTop) > 300
    for i = 1 to 100
        box.delete(array.shift(zoneBox))
        array.shift(zoneTop)
        array.shift(zoneBot)
        array.shift(zoneIsBull)
        array.shift(zoneStartBar)
        array.shift(zoneKind)
        array.shift(zoneActive)

// --------------------------- Swing structure --------------------------------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

var float swingHighVal   = na
var bool  swingHighTaken = false
var float swingLowVal    = na
var bool  swingLowTaken  = false

if not na(ph)
    swingHighVal := ph
    swingHighTaken := false
if not na(pl)
    swingLowVal := pl
    swingLowTaken := false

// ------------------------ Liquidity sweep detection -------------------------
var bool  awaitingBullishMSS = false
var float bullishSweepLevel  = na
var int   bullishSweepBar    = na
var float bullishMSSTarget   = na

var bool  awaitingBearishMSS = false
var float bearishSweepLevel  = na
var int   bearishSweepBar    = na
var float bearishMSSTarget   = na

bool armed = not useKillzones or inKillzone
bool sweepLow  = not na(swingLowVal) and not swingLowTaken and low < swingLowVal and close > swingLowVal and armed
bool sweepHigh = not na(swingHighVal) and not swingHighTaken and high > swingHighVal and close < swingHighVal and armed

if sweepLow
    swingLowTaken := true
    awaitingBullishMSS := true
    bullishSweepLevel := low
    bullishSweepBar := bar_index
    // Freeze the structure high to break, so a later pivot cannot shift it.
    bullishMSSTarget := swingHighVal
    if showSweeps
        label.new(bar_index, low, "SSL Sweep", style = label.style_label_up, color = color.new(color.teal, 20), textcolor = color.white, size = size.tiny)

if sweepHigh
    swingHighTaken := true
    awaitingBearishMSS := true
    bearishSweepLevel := high
    bearishSweepBar := bar_index
    bearishMSSTarget := swingLowVal
    if showSweeps
        label.new(bar_index, high, "BSL Sweep", style = label.style_label_down, color = color.new(color.maroon, 20), textcolor = color.white, size = size.tiny)

if awaitingBullishMSS and (bar_index - bullishSweepBar) > maxWaitBars
    awaitingBullishMSS := false
if awaitingBearishMSS and (bar_index - bearishSweepBar) > maxWaitBars
    awaitingBearishMSS := false

bool bullishMSS = awaitingBullishMSS and not na(bullishMSSTarget) and close > bullishMSSTarget
bool bearishMSS = awaitingBearishMSS and not na(bearishMSSTarget) and close < bearishMSSTarget

if bullishMSS
    awaitingBullishMSS := false
    if showMSS
        line.new(bullishSweepBar, bullishMSSTarget, bar_index, bullishMSSTarget, color = color.teal, width = 2)
        label.new(bar_index, bullishMSSTarget, "Bullish MSS", style = label.style_label_down, color = color.teal, textcolor = color.white, size = size.small)

if bearishMSS
    awaitingBearishMSS := false
    if showMSS
        line.new(bearishSweepBar, bearishMSSTarget, bar_index, bearishMSSTarget, color = color.maroon, width = 2)
        label.new(bar_index, bearishMSSTarget, "Bearish MSS", style = label.style_label_up, color = color.maroon, textcolor = color.white, size = size.small)

// --------------------------- Pending setups ---------------------------------
var float p22LongTop = na
var float p22LongBot = na
var float p22LongSL = na
var float p22LongTP = na
var bool  p22LongOn = false
var int   p22LongBar = na

var float p22ShortTop = na
var float p22ShortBot = na
var float p22ShortSL = na
var float p22ShortTP = na
var bool  p22ShortOn = false
var int   p22ShortBar = na

var float pUniLongTop = na
var float pUniLongBot = na
var float pUniLongSL = na
var float pUniLongTP = na
var bool  pUniLongOn = false
var int   pUniLongBar = na

var float pUniShortTop = na
var float pUniShortBot = na
var float pUniShortSL = na
var float pUniShortTP = na
var bool  pUniShortOn = false
var int   pUniShortBar = na

bool allowLong    = tradeDirection != "Short Only"
bool allowShort   = tradeDirection != "Long Only"
bool allow2022    = tradeModel != "Unicorn Model"
bool allowUnicorn = tradeModel != "2022 Model"
bool flat = strategy.position_size == 0

if bullishMSS and flat
    int fvgIdx = f_findZoneIdx("FVG", true, bullishSweepBar, bar_index)
    int uniIdx = f_findZoneIdx("Unicorn", true, bullishSweepBar, bar_index)
    if allow2022 and allowLong and fvgIdx >= 0
        p22LongTop := array.get(zoneTop, fvgIdx)
        p22LongBot := array.get(zoneBot, fvgIdx)
        p22LongSL := bullishSweepLevel - atr * slBufferATRmult
        float e = (p22LongTop + p22LongBot) / 2
        p22LongTP := e + (e - p22LongSL) * rrRatio
        p22LongOn := true
        p22LongBar := bar_index
    if allowUnicorn and allowLong and uniIdx >= 0
        pUniLongTop := array.get(zoneTop, uniIdx)
        pUniLongBot := array.get(zoneBot, uniIdx)
        pUniLongSL := bullishSweepLevel - atr * slBufferATRmult
        float e = (pUniLongTop + pUniLongBot) / 2
        pUniLongTP := e + (e - pUniLongSL) * rrRatio
        pUniLongOn := true
        pUniLongBar := bar_index

if bearishMSS and flat
    int fvgIdx = f_findZoneIdx("FVG", false, bearishSweepBar, bar_index)
    int uniIdx = f_findZoneIdx("Unicorn", false, bearishSweepBar, bar_index)
    if allow2022 and allowShort and fvgIdx >= 0
        p22ShortTop := array.get(zoneTop, fvgIdx)
        p22ShortBot := array.get(zoneBot, fvgIdx)
        p22ShortSL := bearishSweepLevel + atr * slBufferATRmult
        float e = (p22ShortTop + p22ShortBot) / 2
        p22ShortTP := e - (p22ShortSL - e) * rrRatio
        p22ShortOn := true
        p22ShortBar := bar_index
    if allowUnicorn and allowShort and uniIdx >= 0
        pUniShortTop := array.get(zoneTop, uniIdx)
        pUniShortBot := array.get(zoneBot, uniIdx)
        pUniShortSL := bearishSweepLevel + atr * slBufferATRmult
        float e = (pUniShortTop + pUniShortBot) / 2
        pUniShortTP := e - (pUniShortSL - e) * rrRatio
        pUniShortOn := true
        pUniShortBar := bar_index

// -------------------------- Order management --------------------------------
// Retire a pending setup once its stop is breached before entry, once it grows
// stale, or once any position is open (cancelling a filled order is a no-op).
if p22LongOn and (close < p22LongSL or (bar_index - p22LongBar) > fvgMaxAgeBars or not flat)
    strategy.cancel("2022 Long")
    p22LongOn := false
if p22ShortOn and (close > p22ShortSL or (bar_index - p22ShortBar) > fvgMaxAgeBars or not flat)
    strategy.cancel("2022 Short")
    p22ShortOn := false
if pUniLongOn and (close < pUniLongSL or (bar_index - pUniLongBar) > fvgMaxAgeBars or not flat)
    strategy.cancel("Unicorn Long")
    pUniLongOn := false
if pUniShortOn and (close > pUniShortSL or (bar_index - pUniShortBar) > fvgMaxAgeBars or not flat)
    strategy.cancel("Unicorn Short")
    pUniShortOn := false

if p22LongOn and flat
    float e = (p22LongTop + p22LongBot) / 2
    float q = f_qty(e, p22LongSL)
    if useEquityRisk and not na(q)
        strategy.entry("2022 Long", strategy.long, qty = q, limit = e)
    else
        strategy.entry("2022 Long", strategy.long, limit = e)
    strategy.exit("2022 Long X", "2022 Long", stop = p22LongSL, limit = p22LongTP)

if p22ShortOn and flat
    float e = (p22ShortTop + p22ShortBot) / 2
    float q = f_qty(e, p22ShortSL)
    if useEquityRisk and not na(q)
        strategy.entry("2022 Short", strategy.short, qty = q, limit = e)
    else
        strategy.entry("2022 Short", strategy.short, limit = e)
    strategy.exit("2022 Short X", "2022 Short", stop = p22ShortSL, limit = p22ShortTP)

if pUniLongOn and flat
    float e = (pUniLongTop + pUniLongBot) / 2
    float q = f_qty(e, pUniLongSL)
    if useEquityRisk and not na(q)
        strategy.entry("Unicorn Long", strategy.long, qty = q, limit = e)
    else
        strategy.entry("Unicorn Long", strategy.long, limit = e)
    strategy.exit("Unicorn Long X", "Unicorn Long", stop = pUniLongSL, limit = pUniLongTP)

if pUniShortOn and flat
    float e = (pUniShortTop + pUniShortBot) / 2
    float q = f_qty(e, pUniShortSL)
    if useEquityRisk and not na(q)
        strategy.entry("Unicorn Short", strategy.short, qty = q, limit = e)
    else
        strategy.entry("Unicorn Short", strategy.short, limit = e)
    strategy.exit("Unicorn Short X", "Unicorn Short", stop = pUniShortSL, limit = pUniShortTP)

// ------------------------------ Plots & alerts ------------------------------
plotshape(showMSS and bullishMSS, title = "Bullish MSS", style = shape.triangleup, location = location.belowbar, color = color.teal, size = size.tiny)
plotshape(showMSS and bearishMSS, title = "Bearish MSS", style = shape.triangledown, location = location.abovebar, color = color.maroon, size = size.tiny)
plotshape(showSweeps and sweepLow, title = "SSL Sweep", style = shape.xcross, location = location.belowbar, color = color.teal, size = size.tiny)
plotshape(showSweeps and sweepHigh, title = "BSL Sweep", style = shape.xcross, location = location.abovebar, color = color.maroon, size = size.tiny)

alertcondition(sweepLow, title = "Sell-Side Liquidity Sweep", message = "Sell-side liquidity swept - bullish setup armed")
alertcondition(sweepHigh, title = "Buy-Side Liquidity Sweep", message = "Buy-side liquidity swept - bearish setup armed")
alertcondition(bullishMSS, title = "Bullish MSS", message = "Bullish market structure shift confirmed")
alertcondition(bearishMSS, title = "Bearish MSS", message = "Bearish market structure shift confirmed")
